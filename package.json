{
  "name": "@sharelib-jp/digital-agency-components-svelte-implements",
  "version": "0.0.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharelib-jp/digital-agency-components-svelte-implements.git"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*.svelte": {
      "types": "./dist/components/*.svelte.d.ts",
      "svelte": "./dist/components/*.svelte",
      "default": "./dist/components/*.svelte"
    },
    "./global.css": "./dist/global.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "svelte-package && node scripts/add-declaration-docs.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build -o storybook-static",
    "check:storybook": "svelte-check --tsconfig ./tsconfig.storybook.json",
    "test:storybook": "node scripts/check-storybook.mjs",
    "test:components": "node scripts/run-component-tests.mjs",
    "test:components:browser": "node scripts/run-component-tests.mjs --browser",
    "test:publish-registry": "node --test tests/check-publish-registry.test.mjs",
    "test:package": "pnpm build && node --test tests/package.test.mjs",
    "prepublishOnly": "node scripts/check-publish-registry.mjs && npm run build",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "svelte": "^5.56.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/svelte-vite": "10.6.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.1",
    "storybook": "10.6.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-svelte-plugin": "^0.3.52",
    "vite": "^8.0.16"
  }
}
